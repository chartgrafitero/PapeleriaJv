<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.InventarioController"
            stylesheets="@styles.css"
            styleClass="root-pane"
            prefWidth="1100" prefHeight="640">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Inventario" styleClass="title"/>
                <Label text="Consulta y administra los productos de tu papelería" styleClass="subtitle"/>
            </VBox>
            <Button text="🛒  Ir a ventas" styleClass="btn-secondary" onAction="#handleIrAVentas"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content" spacing="12">

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar producto por nombre…"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="btn-secondary"
                        onAction="#handleEditar"/>
                <Button fx:id="btnEliminar" text="Eliminar" styleClass="btn-danger"
                        onAction="#handleEliminar"/>
                <Button text="+ Nuevo producto" styleClass="btn-primary"
                        onAction="#handleNuevoProducto"/>
            </HBox>

            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No hay productos para mostrar. Usa «+ Nuevo producto» para agregar el primero."
                           styleClass="muted"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colId" text="ID" minWidth="50" maxWidth="70"/>
                    <TableColumn fx:id="colNombre" text="Nombre" minWidth="220"/>
                    <TableColumn fx:id="colPrecioUnidad" text="Precio unidad" minWidth="110"/>
                    <TableColumn fx:id="colPrecioCaja" text="Precio caja" minWidth="110"/>
                    <TableColumn fx:id="colStock" text="Stock (piezas)" minWidth="120"/>
                    <TableColumn fx:id="colUnidades" text="Piezas por caja" minWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets top="0" right="24" bottom="16" left="24"/>
            </padding>
            <Label fx:id="lblResumen" styleClass="hint"/>
            <Label text="Doble clic en un producto para editarlo" styleClass="hint"/>
        </HBox>
    </bottom>
</BorderPane>
