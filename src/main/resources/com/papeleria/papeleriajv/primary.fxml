<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.InventarioController"
      spacing="15"
      prefWidth="750"
      prefHeight="450"
      style="-fx-padding: 20; -fx-background-color: #F7F5EF;">

    <Label text="Inventario de papelería"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Button text="Nuevo producto" onAction="#handleNuevoProducto" />
        <Button text="Actualizar"/>
        <Button text="Eliminar"/>
    </HBox>

    <TableView fx:id="tablaProductos"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="250"/>

            <TableColumn fx:id="colStock"
                         text="Stock"
                         prefWidth="100"/>

            <TableColumn fx:id="colUnidades"
                         text="Unidades por caja"
                         prefWidth="150"/>
        </columns>

    </TableView>

</VBox>

